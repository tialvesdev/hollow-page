# Copie para .env e ajuste. Em produção, defina estas variáveis no painel da hospedagem.
NODE_ENV=development
PORT=3333

# Postgres (local: docker compose up -d; produção: a URL do Neon)
DATABASE_URL=postgresql://hp:hp@localhost:5432/hollowpage
# No Neon: DATABASE_URL é a URL com pooler e DATABASE_URL_UNPOOLED a direta (migrações). `neon env pull` preenche as duas.
# DATABASE_URL_UNPOOLED=
DATABASE_SSL=false

# Segredo das sessões: gere com  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-em-producao-0123456789

# Imagens: "local" grava em ./uploads; "s3" usa um bucket compatível (Cloudflare R2, Supabase Storage, AWS S3)
STORAGE=local
UPLOAD_DIR=uploads
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=hollow-page
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev
